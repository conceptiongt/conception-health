# Copie este archivo como .env.local para trabajar en su computadora.
# En producción se configuran en Vercel → Settings → Environment Variables (tienen prioridad sobre .env.production).
# Solo valores PÚBLICOS: todo lo que empieza con VITE_ llega al navegador. Las llaves secretas
# (Recurrente, WhatsApp, Anthropic) van en Supabase → Edge Functions → Secrets, nunca aquí.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_STUDIO_URL=https://yyyy.supabase.co
VITE_STUDIO_ANON_KEY=sb_publishable_...
VITE_WHATSAPP_SOPORTE=50200000000
VITE_SITIO_URL=https://health.conception-gt.com

# true = demo sin ingreso con datos de ejemplo; false = cuentas reales
VITE_MODO_DEMO=false
